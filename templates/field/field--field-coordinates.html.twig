

{% if not label_hidden %}
   <div{{ title_attributes.addClass('text-xs', 'font-bold', 'text-muted-foreground', 'uppercase', 'tracking-wider', 'pb-0!') }}>
    {{ label }}
   </div>
{% endif %}

<div{{ content_attributes.addClass('text-sm', 'text-foreground', 'prose', 'dark:prose-invert', 'max-w-none', 'pb-4') }}>
    <div class="text-sm text-foreground prose dark:prose-invert max-w-none">
      {{ items[0].content[0]["#title"] }}
    </div>
</div>
 
{% for item in items %}
  <div class="p-0!">
    {{ item.content }}
  </div>
{% endfor %}
