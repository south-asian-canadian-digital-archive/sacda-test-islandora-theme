{#
/**
 * @file
 * Theme override for default field output.
 * Implements Tailwind styling matching the previous manual meta_field macro.
 */
#}
<div{{ attributes.addClass('mb-4') }}>
  {% if not label_hidden %}
    <div{{ title_attributes.addClass('text-xs', 'font-bold', 'text-muted-foreground', 'uppercase', 'tracking-wider', 'mb-1') }}>{{ label }}</div>
  {% endif %}
  
  <div{{ content_attributes.addClass('text-sm', 'text-foreground', 'prose', 'dark:prose-invert', 'max-w-none') }}>
    {% for item in items %}
      <div{{ item.attributes.addClass('text-sm', 'text-foreground', 'prose', 'dark:prose-invert', 'max-w-none') }}>{{ item.content }}</div>
    {% endfor %}
  </div>
</div>
