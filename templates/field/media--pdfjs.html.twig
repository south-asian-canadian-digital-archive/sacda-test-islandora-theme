{{title_prefix}}
{{title_suffix}}

{#
  First-page preview for the `pdfjs` media view mode. The derived thumbnail is
  displayed in the same full-height stage used by image viewers. The real
  pdf.js iframe stays inside a <template>, so it is fetched only after the
  visitor chooses to view the full PDF.
#}
{% set field = pdf_field_name ? content[pdf_field_name] : null %}

<div class="pdf-preview h-auto!" data-pdf-preview>
	<div class="pdf-preview__stage" data-pdf-preview-poster>
		{% if pdf_poster_url %}
			<img src="{{ pdf_poster_url }}" alt="{{ 'First page preview of PDF'|t }}" loading="lazy">
		{% else %}
			<svg class="pdf-preview__fallback" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/>
			</svg>
		{% endif %}

		<div class="pdf-preview__actions" aria-label="{{ 'PDF actions'|t }}">
			{% if field %}
				<button type="button" class="btn btn-primary" data-pdf-preview-open>{{ 'View full PDF'|t }}</button>
			{% endif %}
			{% if pdf_viewer_url %}
				<a href="{{ pdf_viewer_url }}" class="btn btn-outline" target="_blank" rel="noopener noreferrer">
					{{ 'Open in new tab'|t }} <span aria-hidden="true">↗</span>
				</a>
			{% endif %}
		</div>
	</div>

	{% if field %}
		<div class="pdf-preview__viewer" data-pdf-preview-viewer hidden></div>
		<template data-pdf-preview-template>{{ field.0 }}</template>
	{% endif %}

</div>
