{#
/**
 * @file
 * Theme override for Solr Search Content view - individual result.
 *
 * Shows: image, title, and member_of field.
 */
#}
{% set theme_path = '/' ~ active_theme_path() %}
{% set default_image = default_collection_image|default(theme_path ~ '/static/collections/default.jpg') %}

{% set title_field = fields.title.content|default('') %}
{% set member_of_field = fields.member_of_title.content|default('') %}

{# Get image content from various possible field names #}
{% set image_content = fields.did_image.content|default(fields.field_image.content|default(fields.thumbnail.content|default(''))) %}

{# Convert to string and check if content contains an actual image tag #}
{% set image_string = image_content|render|raw %}
{% set display_has_image = '<img' in image_string or 'img' in image_string %}

{# Resolved in sacda_preprocess_views_view_fields(); the old inline read of
   fields.search_api_url is now just one of its fallbacks. #}
{% set url = row_url|default('') %}

{# Is this result a Collection? field_model holds the Islandora model term name. #}
{% set model_string = fields.field_model.content|striptags|trim %}
{% set is_collection = 'Collection' in model_string %}

{# Folder icon badge reused in grid + list image containers. #}
{% set collection_badge %}
	<div class="absolute top-3 left-3 z-10 flex items-center justify-center bg-background/90 backdrop-blur-sm text-foreground p-1.5 rounded shadow-sm" aria-label="{{ 'Collection'|t }}" title="{{ 'Collection'|t }}">
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
		</svg>
	</div>
{% endset %}

{# Media-type placeholder for records that have no representative image.
   Audio/Video have no did_image, so instead of the generic collection
   default we show an icon that signifies the media type. #}
{% set is_audio = 'Audio' in model_string %}
{% set is_video = 'Video' in model_string %}
{% set media_placeholder %}
	{% if is_audio or is_video %}
		<div class="w-full h-full flex flex-col items-center justify-center gap-2 bg-muted text-muted-foreground" aria-label="{{ (is_audio ? 'Audio' : 'Video')|t }}">
			{% if is_audio %}
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
				</svg>
			{% else %}
				<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none"/>
				</svg>
			{% endif %}
			<span class="text-xs font-medium uppercase tracking-wider">{{ (is_audio ? 'Audio' : 'Video')|t }}</span>
		</div>
	{% else %}
		<img src="{{ default_image }}" alt="{{ 'No image'|t }}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105">
	{% endif %}
{% endset %}

{# The real-image branch arrives already wrapped in Drupal's own <a>; the
   placeholder does not, so it gets one here — otherwise records with no
   thumbnail have a large dead zone where every other card is clickable.
   aria-hidden/tabindex="-1" because the title link below is the accessible
   name for this result; without it every card would get two identical tab
   stops. #}
{% set card_media %}
	{% if display_has_image %}
		{{ image_content|raw }}
	{% elseif url %}
		<a href="{{ url }}" tabindex="-1" aria-hidden="true">{{ media_placeholder }}</a>
	{% else %}
		{{ media_placeholder }}
	{% endif %}
{% endset %}

{{ title_prefix }}
{{ title_suffix }}

{# Wrapper with group for hover effects (grid mode) #}
<div class="group cursor-pointer">
	{# Image Container #}
	<div class="relative aspect-square bg-muted overflow-hidden [&_a]:block [&_a]:w-full [&_a]:h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:object-center [&_img]:transition-transform [&_img]:duration-300 group-hover:[&_img]:scale-105">
		{% if is_collection %}{{ collection_badge }}{% endif %}
		{{ card_media }}
	</div>

	{# Info section #}
	<div class="py-2.5">
		<div class="text-sm leading-tight mb-1 [&_a]:text-foreground [&_a]:inline-block group-hover:[&_a]:underline group-hover:[&_a]:decoration-primary [&_a]:transition-colors">
			{{ title_field|raw }}
		</div>
		{% if member_of_field|striptags|trim %}
			<div class="text-xs text-muted-foreground">
				{{ member_of_field|striptags|trim|raw }}
			</div>
		{% endif %}
	</div>
</div>

{# Wrapper with group for hover effects (list mode) #}
	<div class="group cursor-pointer">
    <div class="flex! gap-4 items-start">
		{# Image Container #}
		<div class="relative w-1/2 shrink-0 aspect-square bg-muted overflow-hidden [&_a]:block [&_a]:w-full [&_a]:h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover [&_img]:object-center [&_img]:transition-transform [&_img]:duration-300 group-hover:[&_img]:scale-105">
			{% if is_collection %}{{ collection_badge }}{% endif %}
			{{ card_media }}
		</div>

		{# Info section #}
		<div class="py-1 w-1/2 min-w-0 h-full break-words">
			<div class="text-sm leading-tight mb-1 [&_a]:text-foreground [&_a]:inline-block group-hover:[&_a]:underline group-hover:[&_a]:decoration-primary [&_a]:transition-colors">
				{{ title_field|raw }}
			</div>
			{% if member_of_field|striptags|trim %}
				<div class="text-xs text-muted-foreground">
					{{ member_of_field|striptags|trim|raw }}
				</div>
			{% endif %}
			{% if fields.field_description.content|striptags|trim %}
				<div class="text-xs text-muted-foreground mt-1">
					{{ fields.field_description.content }}
				</div>
			{% endif %}
		</div>
		
	</div>
</div>
