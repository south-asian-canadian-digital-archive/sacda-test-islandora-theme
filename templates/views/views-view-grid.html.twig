{#
/**
 * @file
 * Theme override for views grid - Collections landing page.
 * 
 * Uses collection__grid and collection__item classes for legacy SACDA styling.
 */
#}
<div{{ attributes.addClass('collection__grid') }}>
	{% for row in items %}
		{% for column in row.content %}
			<div{{ column.attributes.addClass('collection__item').removeAttribute('style') }}>
				{{ column.content }}
			</div>
		{% endfor %}
	{% endfor %}
</div>
