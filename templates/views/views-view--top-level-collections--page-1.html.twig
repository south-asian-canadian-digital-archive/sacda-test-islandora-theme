{#
/**
 * @file
 * Theme override for the Top-Level Collections view (page display).
 * View: top_level_collections
 * Display: page_1
 * Path: /collections
 */
#}
{# Hero Section handled by page.html.twig #}

<div{{ attributes }}>
	{{ title_prefix }}
	{{ title_suffix }}

	{# Intro Section #}
	<section class="collection-intro py-10 md:py-14 text-center">
		<p class="text-lg text-secondary max-w-3xl mx-auto">
		    EXPLORE CURATED ARCHIVAL CONTENT <br>
		    Engage with materials of significance that shed light on our past, present, and future, contextualized in their creation.
		</p>
	</section>

	{# Collections Grid #}
	<section class="collections-section pb-16 md:pb-24">
		{# {% if header %}
			<header class="view-header mb-8">
				{{ header }}
			</header>
		{% endif %} #}

		{% if rows %}
				{{ rows }}
		{% elseif empty %}
			<div class="view-empty text-center py-12">
				{{ empty }}
			</div>
		{% endif %}

		{% if pager %}
			<div class="view-pager mt-12">
				{{ pager }}
			</div>
		{% endif %}

	</section>
</div>
