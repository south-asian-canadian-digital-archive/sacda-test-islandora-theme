{#
/**
 * @file
 * Theme override for the team_members view (/about/team).
 *
 * `groups` is built by sacda_preprocess_views_view_unformatted__team_members()
 * (includes/team.inc) rather than by Views' own grouping, which can't key off a
 * field when the row plugin renders whole entities. Each group is its own grid
 * with a heading above it, matching the old sacda.ca layout.
 *
 * Grid is 1 -> 2 -> 3 -> 4 columns; the old site jumped straight to 4 at 768px,
 * and the intermediate steps keep the portrait cards from stretching on tablets.
 * The 3-column step matters now that the page is capped at max-w-5xl: at 768px
 * the container is only ~640px wide inside its gutters, so 4-up would leave
 * ~150px cards with no room for the name plate.
 */
#}

{% set grid_classes = 'team-members-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4' %}

{{ title_prefix }}

{% if groups is defined and groups %}
	{# .team-listing is the hook for dist/team-show-more.js, which reveals cards
	   progressively across all the grids. It expects headings and grids to be
	   direct children in document order. #}
	<div class="team-listing">
		{% for group in groups %}
			{% if group.title %}
				<h2 class="team-group__heading">{{ group.title }}</h2>
			{% endif %}
			<div class="{{ grid_classes }}">
				{% for row in group.rows %}
					<div{{ row.attributes.addClass('h-full') }}>
						{{ row.content }}
					</div>
				{% endfor %}
			</div>
		{% endfor %}
	</div>
{% else %}
	{# No grouping data — fall back to a single flat grid. #}
	<div{{ attributes.addClass(grid_classes|split(' ')) }}>
		{% for row in rows %}
			<div{{ row.attributes.addClass('h-full') }}>
				{{ row.content }}
			</div>
		{% endfor %}
	</div>
{% endif %}

{{ title_suffix }}
