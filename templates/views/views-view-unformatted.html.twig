{#
/**
 * @file
 * Theme override for Solr Search Content view - grid wrapper.
 */
#}
<div{{ attributes.addClass('search-content-container') }}>
    {{ title_prefix }}
	{% for row in rows %}
		<div{{ row.attributes.addClass('bg-background', 'overflow-hidden') }}>
			{{ row.content }}
		</div>
	{% endfor %}
</div>

