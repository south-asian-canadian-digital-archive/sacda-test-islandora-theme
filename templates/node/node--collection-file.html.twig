{#
/**
 * @file
 * Theme override to display a node of type 'collection_file'.
 * Implements the "Sandwich" layout and "Gallery View" design.
 */
#}

<article{{ attributes.addClass('node-collection') }}>

		{{ title_prefix }}
		{{ title_suffix }}



		{% if content.body|render|striptags|trim %}
			<div class="prose max-w-none text-foreground leading-relaxed">
				{{ content.body }}
			</div>
		{% endif %}

		<div class="flex flex-col md:flex-row gap-6">
			{{ content|without('body') }}
		</div>

</article>


