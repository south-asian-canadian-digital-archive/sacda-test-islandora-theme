{% extends '@sacda/page/page.html.twig' %}

{% block content %}
	{% import '@sacda/macros/button.twig' as btn %}

	{# Outside <main>, matching page--about--team and page--about--media: the
	   subnav is section navigation, not page content, and keeping the three
	   templates structurally identical is what lets _about.css tighten the gap
	   above it with one rule. #}
	{% import '@sacda/macros/about-subnav.twig' as subnav %}
	{{ subnav.render('about') }}

<main role="main">

	{# Intro band. The <section> stays full-bleed so the tint spans the viewport;
	   every inner wrapper on this page uses the sitewide content container
	   (max-w-5xl + px-4/md:px-16) so copy lines up with the rest of the site. #}
	<section class="bg-light pt-12 md:pt-16 lg:pt-20 pb-20 md:pb-28 lg:pb-32">
		<div class="max-w-5xl mx-auto px-4 md:px-16 text-center">
			<h2>A PAN-CANADIAN DIGITAL ARCHIVE</h2>
			<p class="text-lg text-secondary leading-relaxed mt-4">
				The South Asian Canadian Digital Archive (SACDA) collects, digitizes, and preserves materials connected to the South Asian diaspora across Canada. From photographs and documents to oral histories and community records, SACDA safeguards the stories of South Asian Canadians for future generations.
			</p>
			<p class="text-lg text-secondary leading-relaxed mt-4">
				SACDA is an initiative of the South Asian Studies Institute (SASI) at the University of the Fraser Valley, working with individuals, families, and organizations across the country to build a truly pan-Canadian digital archive.
			</p>
		</div>
	</section>

	{# The content region carries the node itself (system_main_block), so it must be
	   rendered or the node body is silently dropped and admins get no contextual
	   edit links. Sits after the hardcoded intro so editable copy reads as part of
	   it; nothing here is layout-coupled, unlike the contact card.

	   region--content.html.twig skips its own max-w cap on /about* pages
	   (self_widthed_content), so the container has to be supplied here. #}
	<div class="about-body content max-w-5xl mx-auto px-4 md:px-16">
		{{ page.content }}
	</div>

	{# Main two-column: stacked images left, program sections right #}
	<section class="about-main grid grid-cols-1 lg:grid-cols-2 max-w-5xl mx-auto px-4 md:px-16 py-20 md:py-28 lg:py-32 gap-10 lg:gap-16">

		<div class="flex flex-col gap-6 lg:gap-8">
			<div class="img-hover-zoom">
				<img src="{{ base_path ~ directory }}/static/graphics/about/about-1.jpg" alt="Archival materials from the SACDA collections" class="w-full object-cover">
			</div>
			<div class="img-hover-zoom">
				<img src="{{ base_path ~ directory }}/static/graphics/about/about-2.jpg" alt="Community members exploring the archive" class="w-full object-cover">
			</div>
		</div>

		<div class="flex flex-col gap-12 lg:gap-16 lg:py-4">
			{% set programs = [
				{
					title: 'South Asian Studies Institute',
					description: 'The South Asian Studies Institute at the University of the Fraser Valley advances research, teaching, and community engagement on the histories and contemporary experiences of South Asian Canadians.',
					link: 'https://www.ufv.ca/sasi/'
				},
				{
					title: 'South Asian Canadian Legacy Project',
					description: 'A province-wide initiative documenting and celebrating the contributions of South Asian Canadians in British Columbia through museum exhibits, curriculum resources, and community histories.',
					link: 'https://southasiancanadianheritage.ca/'
				},
				{
					title: 'SACDA Media',
					description: 'SACDA Media produces and shares documentaries, oral history recordings, and multimedia storytelling that bring the archive’s collections to life.',
					link: '/about/media'
				}
			] %}

			{% for program in programs %}
				<div>
					<h3 class="h3-underline uppercase">{{ program.title }}</h3>
					<p class="text-secondary leading-relaxed mt-5 mb-6">{{ program.description }}</p>
					{{ btn.link('Learn More', program.link, { variant: 'outline' }) }}
				</div>
			{% endfor %}
		</div>

	</section>

	{# Supporters band #}
	<section class="bg-light py-20 md:py-28 lg:py-32">
		<div class="max-w-5xl mx-auto px-4 md:px-16 text-center">
			<h3 class="h3-underline uppercase">PROUDLY SUPPORTED BY</h3>
			{# w-auto alone lets a wide logo (the BCHDP/UBC lockup is ~8:1) push
			   past the container; max-w-full + object-contain caps it instead. #}
			<div class="flex flex-col md:flex-row flex-wrap items-center justify-evenly gap-12 md:gap-10 mt-14">
				<img src="{{ base_path ~ directory }}/static/graphics/bc-dark.png" alt="Government of British Columbia" class="h-12 md:h-16 w-auto max-w-full object-contain">
				<img src="{{ base_path ~ directory }}/static/graphics/canada_logo_dark.svg" alt="Government of Canada" class="h-12 md:h-16 w-auto max-w-full object-contain">
				<img src="{{ base_path ~ directory }}/static/graphics/footer/BCHDP_logo.svg" alt="BC History Digitization Program" class="h-16 md:h-20 w-auto max-w-full md:max-w-[22rem] object-contain">
			</div>
		</div>
	</section>

	{# Meet the Team #}
	<section class="about-team relative w-full">
		<img src="{{ base_path ~ directory }}/static/graphics/about/team-bg.jpg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover z-0">
		{# Two wrappers on purpose: the photo stays full-bleed while the outer div
		   is the standard container, so the frosted panel's edges land exactly on
		   the content column the other sections' copy sits in. Capping the panel
		   itself instead would make it 5xl *including* the gutters — i.e. wider
		   than the text above and below it. (It originally carried a plain `m-*`,
		   so it just grew with the viewport.) #}
		<div class="relative z-1 max-w-5xl mx-auto px-4 md:px-16 py-6 md:py-12 xl:py-24">
			<div class="bg-white/75 xl:bg-white/95 p-8 md:p-14 xl:p-20 text-center">
				<h2>MEET THE TEAM</h2>
				<p class="text-lg text-secondary leading-relaxed mt-4 mb-8">
					SACDA is built by a dedicated team of archivists, researchers, students, and community members who work together to preserve South Asian Canadian history.
				</p>
				{{ btn.link('Learn More', '/about/team', { variant: 'primary', full_width: true }) }}
			</div>
		</div>
	</section>

	{# Contribute CTA #}
	<section class="bg-light py-20 md:py-28 lg:py-32 text-center">
		<div class="max-w-5xl mx-auto px-4 md:px-16">
			<h2>HELP TELL OUR STORY</h2>
			<p class="text-lg text-secondary leading-relaxed mt-4 mb-8">
				Do you have access to materials and/or oral histories of significance you could contribute to our digital archives?
			</p>
			<div class="flex justify-center">
				{{ btn.link('Contribute to SACDA', '/contact', { variant: 'outline' }) }}
			</div>
		</div>
	</section>
</main>
{% endblock %}
