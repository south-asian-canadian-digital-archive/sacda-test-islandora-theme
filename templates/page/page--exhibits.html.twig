{#
/**
 * @file
 * Page template for /exhibits — the exhibits listing View.
 * Hero + centered intro + full-width content, no sidebars.
 */
#}
{% extends '@sacda/page/page.html.twig' %}

{% block content %}

	<main role="main" class="flex flex-col py-12 md:py-20">
		{# Intro #}
		<section class="pb-10 md:pb-16">
			<div class="max-w-4xl mx-auto px-6 md:px-10 text-center">
				<h2>VIEW EXHIBITS ON SOUTH ASIAN CANADIAN HISTORY</h2>
				<p class="text-lg leading-relaxed mt-5">
					Explore curated stories on South Asian Canadian history, drawn from the collections of the archive.
				</p>
			</div>
		</section>

		<div class="content w-full px-6 md:px-10 lg:px-16">
			{{ page.content }}
		</div>
	</main>
{% endblock %}
