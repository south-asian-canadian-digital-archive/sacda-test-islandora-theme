{#
/**
 * @file
 * Page template for /exhibits — the exhibits listing View.
 * Hero + full-width content, no sidebars.
 */
#}
{% extends '@sacda/page/page.html.twig' %}

{% block content %}
	{% import '@sacda/macros/hero.twig' as hero %}

	{{ hero.section(sacda_hero ?? {
    title: 'EXHIBITS',
    subtitle: 'Explore curated digital exhibits from the South Asian Canadian Digital Archive.'
}) }}

	<main role="main" class="flex flex-col gap-8 my-8">
		<div class="content w-full">
			{{ page.content }}
		</div>
	</main>
{% endblock %}
