{% extends '@sacda/page/page.html.twig' %}

{#
	Newsletter page — "The Hive" (SACDA's Mailchimp newsletter).

	Source of truth is Mailchimp (account us4, u=3c616907ab5cf63924a62f942,
	audience id=383fd0ae1e). Verified 2026-07-23:

	- Public campaign archive (iframed below — sends no X-Frame-Options /
	  frame-ancestors, so embedding works):
	  https://us4.campaign-archive.com/home/?u=3c616907ab5cf63924a62f942&id=383fd0ae1e

	- RSS feed of past issues (application/rss+xml, but NO CORS headers, so it
	  cannot be fetched from browser JS — a client-side Svelte island would need
	  a server-side proxy or Drupal Feeds/Views aggregation):
	  https://us4.campaign-archive.com/feed?u=3c616907ab5cf63924a62f942&id=383fd0ae1e

	- Signup form action (same one the old sacda.ca /Contribute/Items page used):
	  https://sacda.us4.list-manage.com/subscribe/post?u=3c616907ab5cf63924a62f942&id=383fd0ae1e&f_id=000f56e2f0
#}

{% block content %}

	{# Intro #}
	<section class="py-10 md:py-16">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<h2>OUR NEWSLETTER</h2>
			<p class="text-lg text-secondary leading-relaxed mt-4">
				The Hive shares stories from the archive, new collections and exhibits, community events, and behind-the-scenes updates from the SACDA team.
			</p>
		</div>
	</section>

	{# Signup #}
	<section class="bg-light py-10 md:py-16">
		<div class="max-w-2xl mx-auto px-4 text-center">
			<h2>SUBSCRIBE</h2>
			<p class="text-secondary leading-relaxed mt-4 mb-8">
				Get each new issue of The Hive delivered straight to your inbox.
			</p>
			<form action="https://sacda.us4.list-manage.com/subscribe/post?u=3c616907ab5cf63924a62f942&amp;id=383fd0ae1e&amp;f_id=000f56e2f0" method="post" target="_blank" class="flex flex-col sm:flex-row justify-center gap-4">
				<label for="mce-EMAIL" class="sr-only">Email address</label>
				<input type="email" name="EMAIL" id="mce-EMAIL" required placeholder="Your email address" class="w-full sm:w-80 px-4 py-3 border border-secondary/40 bg-white focus:outline-none focus:border-primary">
				{# Mailchimp honeypot — must stay present and empty #}
				<div style="position: absolute; left: -5000px;" aria-hidden="true">
					<input type="text" name="b_3c616907ab5cf63924a62f942_383fd0ae1e" tabindex="-1" value="">
				</div>
				<button type="submit" class="px-8 py-3 bg-primary text-white font-bold uppercase tracking-wide hover:bg-primary/90 cursor-pointer">
					Subscribe
				</button>
			</form>
		</div>
	</section>

	{# Past issues — Mailchimp public campaign archive #}
	<section class="py-10 md:py-16">
		<div class="max-w-7xl mx-auto px-4">
			<h2 class="text-center mb-8">PAST ISSUES</h2>
			<div class="border border-secondary/20 overflow-hidden">
				<iframe
					src="https://us4.campaign-archive.com/home/?u=3c616907ab5cf63924a62f942&amp;id=383fd0ae1e"
					title="The Hive newsletter archive"
					loading="lazy"
					class="w-full border-0"
					style="height: 70vh; min-height: 500px;"></iframe>
			</div>
			<p class="text-center text-secondary mt-4">
				<a href="https://us4.campaign-archive.com/home/?u=3c616907ab5cf63924a62f942&amp;id=383fd0ae1e" target="_blank" rel="noopener" class="underline hover:text-primary">
					Open the newsletter archive in a new tab
				</a>
			</p>
		</div>
	</section>
{% endblock %}
