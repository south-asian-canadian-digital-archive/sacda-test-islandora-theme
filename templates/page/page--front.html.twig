{#
/**
 * @file
 * SACDA theme front page template.
 * Extends the base page layout and overrides just the main content.
 */
#}
{% extends '@sacda/layout/page.html.twig' %}
{% import '@sacda/macros/button.twig' as btn %}
{% import '@sacda/macros/search.twig' as search %}

{% block main %}
	<main role="main" class="front-page w-full">
		<a id="main-content" tabindex="-1"></a>

		<div class="w-full min-h-[40vh] pt-4">
			{% include '@sacda/block/sacda-carousel.html.twig' with {
			slides: carousel_slides,
			autoplay_speed: carousel_autoplay_speed,
			slides_per_view: 3,
			slides_per_view_tablet: 2,
			slides_per_view_mobile: 1,
		} %}
		</div>

		{{ page.content_top }}

		{# 1. Hero Search & Mission Section #}
		<section
			class="relative my-6 py-10 md:py-16 bg-light overflow-hidden">
			{# Background circles - positioned at bottom as HTML img #}
			<img src="{{ theme_path }}/static/homepage/bg-circles.svg" alt="" class="hidden md:block absolute bottom-0 left-0 w-full h-auto pointer-events-none select-none" aria-hidden="true">

			<div class="relative z-10 px-4 md:px-24">
				<div class="container mx-auto">
					<div class="flex flex-wrap pb-8 md:mb-16 md:pb-20 border-b border-b-secondary">
						<div class="hidden md:block w-1/3 pr-4">
							<h2>SEARCH</h2>
						</div>
						<div class="w-full md:w-2/3">
							<form action="https://sacda.ca/search" method="get" class="flex items-center pt-2 w-full">
								{{ search.input({
								id: 'frontSearchInput',
								variant: 'hero',
							}) }}
							</form>
						</div>
					</div>

					<div class="flex flex-wrap">
						<div class="hidden md:block w-1/3 pr-4">
							<h2>EXPLORE THE JOURNEY</h2>
						</div>
						<div class="w-full md:w-2/3 text-secondary">
							<p class="hidden md:block mb-8 text-lg leading-relaxed">
								Engage with the rich history of the South Asian Canadian diaspora. Explore stories of immigration, community building, cultural preservation, and the enduring contributions of South Asian Canadians to the fabric of our nation.
							</p>
							<div class="flex flex-col md:flex-row gap-5 mt-10 md:mt-14">

								{{ btn.link('About', 'https://sacda.ca/about', { variant: 'outline', class: 'w-full md:w-auto' }) }}
								{{ btn.link('Advanced Search', 'https://sacda.ca/search/advanced', { variant: 'outline', class: 'w-full md:w-auto' }) }}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		{# 2. Land Acknowledgement #}
		<section class="bg-primary/60 text-center py-10 md:py-16 lg:py-24 my-6 md:my-0">
			<div class="px-4 md:px-24 mx-auto">
				<div class="mb-4">
					<h2>LAND ACKNOWLEDGEMENT</h2>
				</div>
				<div class="max-w-4xl mx-auto">
					<p class="text-secondary text-lg leading-relaxed">
						We respectfully acknowledge that the South Asian Canadian Digital Archive at the South Asian Studies Institute is located on the traditional, ancestral, and unceded territory of the Stó:lō peoples. We are grateful for the opportunity to live, work, and learn on these lands.
					</p>
				</div>
			</div>
		</section>

		{# 3. Featured Exhibits #}
		<section class="home-collection px-4 md:px-24 py-10">
			<h2>Featured Exhibits</h2>

			<div class="home-exhibits">
				{% set exhibits = [
					{ title: 'Komagata Maru Exhibit', link: 'https://sacda.ca/exhibits/komagata-maru', image: theme_path ~ '/static/homepage/Komogata-Maru-Exhibit_South-Asian-Canadian.jpg' },
					{ title: 'Labour History Exhibit', link: 'https://sacda.ca/exhibits/labour-history', image: theme_path ~ '/static/homepage/Labour-History-Exhibit_South-Asian-Canadian.jpg' },
					{ title: 'The Vote Exhibit', link: 'https://sacda.ca/exhibits/the-vote', image: theme_path ~ '/static/homepage/The-Vote-Exhibit_South-Asian-Canadian.jpg' }
				] %}

				{% for exhibit in exhibits %}
					<div class="home-exhibits-item">
						<a href="{{ exhibit.link }}">
							<img src="{{ exhibit.image }}" alt="{{ exhibit.title }}">
							<div class="home-exhibits-title">
								<h3>{{ exhibit.title }}</h3>
							</div>
						</a>
					</div>
				{% endfor %}
			</div>
		</section>

		{# 4. Explore Themes (Asymmetric Grid) #}
		<section class="py-10 px-4 md:px-24">
			<div class="hidden md:block mb-8 text-center">
				<h2>Explore Themes</h2>
				<p class="text-lg text-secondary">Navigate the digital archives through curated thematic collections.</p>
			</div>

			{% set themes = [
				{ title: 'Advocacy', link: 'https://sacda.ca/themes/advocacy', image: theme_path ~ '/static/homepage/Advocacy-Theme_South-Asian-Canadian.jpg', colspan: 2, rowspan: 1 },
				{ title: 'Arts and Culture', link: 'https://sacda.ca/themes/arts-culture', image: theme_path ~ '/static/homepage/Arts-Culture_South-Asian-Canadian.jpg', colspan: 1, rowspan: 2 },
				{ title: 'Migration', link: 'https://sacda.ca/themes/migration', image: theme_path ~ '/static/homepage/Migration-theme_South-Asian-Canadian.jpg', colspan: 1, rowspan: 1 },
				{ title: 'Family', link: 'https://sacda.ca/themes/family', image: theme_path ~ '/static/homepage/Family_South-Asian-Canadian.jpg', colspan: 1, rowspan: 1 }
			] %}

			<div class="hidden md:grid grid-cols-3 grid-rows-[25vw_25vw] gap-4">
				{% for theme in themes %}
					<div class="relative overflow-hidden group {% if theme.colspan == 2 %}col-span-2{% endif %} {% if theme.rowspan == 2 %}row-span-2{% endif %}">
						<a href="{{ theme.link }}" class="block w-full h-full">
							<img src="{{ theme.image }}" alt="{{ theme.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
							<div class="absolute top-0 left-0 flex justify-center items-center min-w-[250px] lg:min-w-[300px] min-h-[60px] p-4 bg-primary">
								<h3>{{ theme.title }}</h3>
							</div>
						</a>
					</div>
				{% endfor %}
			</div>

			{# Mobile version #}
			<div class="md:hidden">
				<h2>Explore Themes</h2>
				<div class="flex flex-col gap-4">
					{% for theme in themes %}
						<a href="{{ theme.link }}" class="relative overflow-hidden h-48">
							<img src="{{ theme.image }}" alt="{{ theme.title }}" class="w-full h-full object-cover">
							<div class="absolute top-0 left-0 bg-primary p-3">
								<h3>{{ theme.title }}</h3>
							</div>
						</a>
					{% endfor %}
				</div>
			</div>
		</section>

		{# 5. Walk Through History (Recently Added) #}
		<section class="py-10 px-4 md:px-24 pb-16 md:pb-36">
			<div class="flex flex-wrap mb-8">
				<div class="w-full md:w-1/3">
					<h2>WALK THROUGH HISTORY</h2>
				</div>
				<div class="w-full md:w-2/3 mt-4 md:mt-0">
					<p class="text-lg text-secondary">For over 100 years, the contributions of South Asian Canadians have shaped the cultural, economic, and social landscape of Canada. Explore our growing collection of historical artifacts.</p>
				</div>
			</div>

			{% set recent_items = [
				{ title: 'Chandra Bodalia Collection', link: 'https://sacda.ca/collections/chandra-bodalia', image: theme_path ~ '/static/homepage/Chandra-Bodalia-Collection_South-Asian-Canadian.jpg' },
				{ title: 'Del Monte Collection', link: 'https://sacda.ca/collections/del-monte', image: theme_path ~ '/static/homepage/delmonte.jpg' },
				{ title: 'Joan Mayo Fonds', link: 'https://sacda.ca/collections/joan-mayo', image: theme_path ~ '/static/homepage/joanmayofonds.jpg' }
			] %}

			<div class="hidden md:grid grid-cols-3 gap-6 h-[25vw]">
				{% for item in recent_items %}
					<div class="relative overflow-hidden group h-full">
						<a href="{{ item.link }}" class="block w-full h-full">
							<img src="{{ item.image }}" alt="{{ item.title }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
							<div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-[calc(100%-30px)] lg:w-[calc(100%-80px)] min-h-[60px] flex justify-center items-center bg-primary p-4">
								<h3>{{ item.title }}</h3>
							</div>
						</a>
					</div>
				{% endfor %}
			</div>

			{# Mobile version #}
			<div class="md:hidden flex flex-col gap-4">
				{% for item in recent_items %}
					<a href="{{ item.link }}" class="relative overflow-hidden h-48">
						<img src="{{ item.image }}" alt="{{ item.title }}" class="w-full h-full object-cover">
						<div class="absolute bottom-4 left-4 right-4 bg-primary p-3">
							<h3>{{ item.title }}</h3>
						</div>
					</a>
				{% endfor %}
			</div>
		</section>

		{# 6. Help Tell Our Story (CTA) #}
		<section class="bg-light py-10 md:py-32 text-center">
			<div class="px-4 md:px-24 max-w-4xl mx-auto">
				<h2>HELP TELL OUR STORY</h2>
				<p class="text-lg text-secondary mb-8">
					Do you have access to materials and/or oral histories of significance you could contribute to our digital archives?
				</p>
				<div class="flex justify-center">
					{{ btn.link('Contribute to SACDA', 'https://sacda.ca/contribute', { variant: 'outline' }) }}
				</div>
			</div>
		</section>

		{# Dynamic Drupal content if any #}
		{% if page.content %}
			<div class="container mx-auto px-4 py-12 *:min-h-0!">
				{{ page.content }}
			</div>
		{% endif %}

	</main>
{% endblock %}
