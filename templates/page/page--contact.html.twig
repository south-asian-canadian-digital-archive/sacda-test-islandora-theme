{% extends '@sacda/page/page.html.twig' %}

{% block content %}
<main role="main">

	{# Intro — large bottom padding is intentional: the contact card pulls up into it #}
	<section class="contact-intro text-center px-4">
		<h2 class="uppercase">LET'S CHAT</h2>
		<p class="mt-4">Get in touch with the team behind the South Asian Canadian Digital Archive.</p>
	</section>

	{# Full-width section with background graphic + overlaid card #}
	<section class="contact-section relative w-full">
		<img src="{{ base_path ~ directory }}/static/graphics/contact/section-bg.jpg" class="section-bg hidden md:block absolute inset-0 w-full h-full object-cover z-0" alt="" aria-hidden="true">

		<div class="contact-card relative z-1 bg-light grid grid-cols-1 lg:grid-cols-2 items-center">

			<div class="contact__content p-[60px] xl:p-[80px]">
				<h3 class="h3-underline uppercase mb-[45px]">CONTACT</h3>

				<h4>Address</h4>
				<p>
					South Asian Canadian Digital Archive<br>
					South Asian Studies Institute<br>
					Building K, University of the Fraser Valley
					<br>
					33844 King Road, Abbotsford, BC V2S 7M8
				</p>

				<h4 class="mt-[45px]">Email</h4>
				<a href="mailto:sacda@ufv.ca">sacda@ufv.ca</a>

				<h4 class="mt-[45px]">Phone</h4>
				<a href="tel:+16048544547">(604) 854-4547</a>
			</div>

			<div class="contact__map w-full h-full min-h-[400px] xl:max-h-[700px]">
				<iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1673.6796605941547!2d-122.28907861683435!3d49.02974787742539!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x54844bebe7ef0241%3A0xbbf2fa6d7e1d808!2sUFV%20Building%20K!5e0!3m2!1sen!2sca!4v1706726549563!5m2!1sen!2sca" width="600" height="600" style="border:0; width:100%; height:100%; outline: none;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map to the South Asian Studies Institute, UFV Building K"></iframe>
			</div>

		</div>
	</section>

	{# The content region carries the node itself (system_main_block), so it must be
	   rendered or the node body is silently dropped and admins get no contextual
	   edit links. Placed AFTER the card on purpose: .contact-intro's bottom padding
	   and .contact-card's negative top margin are a matched pair, and anything
	   inserted between them breaks the overlap. #}
	<div class="contact-body content">
		{{ page.content }}
	</div>
</main>
{% endblock %}
