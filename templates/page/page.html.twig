{#
/**
 * @file
 * SACDA theme's page template - overrides Olivero to use custom header/footer.
 * Keeps the main content area intact from Olivero.
 */
#}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
<div id="page-wrapper" class="page-wrapper">
	<div id="page">

		{# MOBILE HEADER (shown < 768px) #}
		{% include '@sacda/navigation/mobile-header.html.twig' with { is_front: is_front } %}

		{# DESKTOP HEADER (shown >= 768px) #}
		{% include '@sacda/navigation/header.html.twig' with { is_front: is_front } %}

		{% block main %}
			<div id="main-wrapper" class="layout-main-wrapper layout-container">
				<div class="main-content w-full">
					<a id="main-content" tabindex="-1"></a>
					{% block hero %}
						{# Render Global Hero from Page Preprocess #}
						{% if hero_data %}
							{% import '@sacda/macros/hero.twig' as hero %}
							{% if hero_data.image %}
								{{ hero.section(hero_data) }}
							{% endif %}
						{% endif %}
					{% endblock %}

					{{ page.highlighted }}
					{{ page.breadcrumb }}
					{{ page.content_above }}

					{% block content %}
					<main role="main" class="flex flex-col gap-8 my-8">
						<div class="content">
							{{ page.content }}
						</div>
						{% if page.content_children or show_filters_sidebar %}
							<section class="content-children-layout max-w-5xl mx-auto px-4 md:px-16 w-full">
							{% if show_filters_sidebar %}
							<aside class="filters-sidebar">
							        {{ page.filters }}
							</aside>
							{% endif %}
							        <div class="{% if show_filters_sidebar %}content-children{% else %}w-full{% endif %}">
							                {{ page.content_children }}
							        </div>
							</section>						{% endif %}
					</main>
					{% endblock %}

				</div>
			</div>
		{% endblock %}

		{# FOOTER #}
		{% include '@sacda/navigation/footer.html.twig' %}

		<div class="overlay" data-drupal-selector="overlay"></div>

	</div>
</div>
