{#
/**
 * @file
 * Theme override for Citation Select block.
 */
#}
<div{{ attributes }}>
	{{ title_prefix }}
	{% if label %}
		<div{{ title_attributes.addClass('text-xs', 'font-bold', 'text-muted-foreground', 'tracking-wider', 'mb-1') }}>{{ label }}</div>
	{% endif %}
	{{ title_suffix }}
	<div class="text-sm">
			{{ content }}
	</div>
</div>
