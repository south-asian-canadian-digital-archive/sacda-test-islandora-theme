{#
/**
 * @file
 * Sub-navigation for the About branch (/about, /about/team, /about/media).
 *
 * Previously copy-pasted into each of the three page templates with different
 * markup and classes in each, so the three pages didn't visually agree. Kept as
 * a macro so adding a sub-page is a one-line change.
 *
 * Usage:
 *   {% import '@sacda/macros/about-subnav.twig' as subnav %}
 *   {{ subnav.render('team') }}
 */
#}

{% macro render(active) %}
	{% set links = [
		{ id: 'about', title: 'About'|t, url: '/about' },
		{ id: 'team',  title: 'Team'|t,  url: '/about/team' },
		{ id: 'media', title: 'Media'|t, url: '/about/media' },
	] %}

	<nav class="about-subnav" aria-label="{{ 'About section'|t }}">
		<ul>
			{% for link in links %}
				{% set is_active = link.id == active %}
				<li>
					<a href="{{ link.url }}"
						class="{{ is_active ? 'is-active' : '' }}"
						{% if is_active %}aria-current="page"{% endif %}>
						{{ link.title }}
					</a>
				</li>
			{% endfor %}
		</ul>
	</nav>
{% endmacro %}
