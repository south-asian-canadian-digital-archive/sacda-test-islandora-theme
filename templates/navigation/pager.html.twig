{#
/**
 * @file
 * Theme override to display a pager.
 */
#}
{% if items %}
	<nav class="pager my-8! md:my-12!" role="navigation" aria-labelledby="pagination-heading">
		<h4 id="pagination-heading" class="visually-hidden">{{ 'Pagination'|t }}</h4>
		<ul class="pager gap-1!">

			{% if items.first %}
				<li class="pager__item pager__item--first">
					<a href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}" {{ items.first.attributes }}>
						<span class="visually-hidden">{{ 'First page'|t }}</span>
						<svg viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
					</a>
				</li>
			{% endif %}

			{% if items.previous %}
				<li class="pager__item pager__item--previous">
					<a href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev" {{ items.previous.attributes }}>
						<span class="visually-hidden">{{ 'Previous page'|t }}</span>
						<svg viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
					</a>
				</li>
			{% endif %}

			{% if ellipses.previous %}
				<li class="pager__item pager__item--ellipsis" role="presentation">
					<span>&hellip;</span>
				</li>
			{% endif %}

			{% for key, item in items.pages %}
				<li class="pager__item{{ current == key ? ' is-active pager__item--current' : '' }}">
					{% if current == key %}
						<span title="{{ 'Current page'|t }}">{{ key }}</span>
					{% else %}
						<a href="{{ item.href }}" title="{{ 'Go to page @key'|t({'@key': key}) }}" {{ item.attributes }}>{{ key }}</a>
					{% endif %}
				</li>
			{% endfor %}

			{% if ellipses.next %}
				<li class="pager__item pager__item--ellipsis" role="presentation">
					<span>&hellip;</span>
				</li>
			{% endif %}

			{% if items.next %}
				<li class="pager__item pager__item--next">
					<a href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next" {{ items.next.attributes }}>
						<span class="visually-hidden">{{ 'Next page'|t }}</span>
						<svg viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
					</a>
				</li>
			{% endif %}

			{% if items.last %}
				<li class="pager__item pager__item--last">
					<a href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}" {{ items.last.attributes }}>
						<span class="visually-hidden">{{ 'Last page'|t }}</span>
						<svg viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
					</a>
				</li>
			{% endif %}

		</ul>
	</nav>
{% endif %}
