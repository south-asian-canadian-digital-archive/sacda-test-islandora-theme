{#
/**
 * @file
 * Override for content region - removes Olivero's wrapper constraints.
 */
#}

{% set layout_classes = [ 'region', 'region-content' ] %}

{# Outer width control for everything in the content region (the node AND any
   sibling blocks like the citation block, so nothing runs full-bleed):
   - search page: full width, it manages its own layout.
   - everything else: the standard content width, matching the rest of the
     site (max-w-5xl). #}
{% if route_name == 'view.solr_search_content.page_1' %}
  {# full width — no wrapper constraints #}
{% else %}
  {% set layout_classes = layout_classes|merge(['max-w-5xl', 'mx-auto', 'px-4', 'md:px-16']) %}
{% endif %}

{# {{ dump(route_name) }} #}

{% if content %}
	<div{{ attributes.addClass(layout_classes) }}>
		{{ content }}
	</div>
{% endif %}
